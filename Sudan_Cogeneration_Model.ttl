#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :High_Cogeneration_Potential
                :Low_Cogeneration_Potential
                :Moderate_Cogeneration_Potential
              )
] .


