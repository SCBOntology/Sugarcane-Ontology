                         owl:equivalentClass [ owl:intersectionOf ( :Sugarcane_Acreage
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :has_Sugarcane_Acreage ;
                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                           owl:onDatatype xsd:decimal ;
                                                                                           owl:withRestrictions ( [ xsd:minInclusive 0.01
                                                                                                                  ]
                                                                                                                )
                                                                                         ]
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :has_Sugarcane_Acreage ;
                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                           owl:onDatatype xsd:decimal ;
                                                                                           owl:withRestrictions ( [ xsd:maxInclusive 0.05
                                                                                                                  ]
                                                                                                                )
                                                                                         ]
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :Sugarcane_Acreage .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sociological_Factor_Indicator
:Sociological_Factor_Indicator rdf:type owl:Class ;
                               rdfs:subClassOf :Pestle_Factor_Indicator .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sub_Saharan_Africa_Region
:Sub_Saharan_Africa_Region rdf:type owl:Class ;
                           rdfs:subClassOf :Africa_Region .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Acreage
:Sugarcane_Acreage rdf:type owl:Class ;
                   rdfs:subClassOf :Sociological_Factor_Indicator .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Bioeconomy
:Sugarcane_Bioeconomy rdf:type owl:Class ;
                      rdfs:subClassOf :Global_Sugarcane_Feedstock_Supply_Chain .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Geo_Spatial_Region
:Sugarcane_Geo_Spatial_Region rdf:type owl:Class ;
                              rdfs:subClassOf :Global_Sugarcane_Feedstock_Supply_Chain .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Low_Producer
:Sugarcane_Low_Producer rdf:type owl:Class ;
                        rdfs:subClassOf :Sugarcane_Producer ;
                        rdfs:comment "Low Producers (LP): Nations with production volumes below 1 million tonne (<1 MT), corresponding to small-scale producers." .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Medium_Producer
:Sugarcane_Medium_Producer rdf:type owl:Class ;
                           rdfs:subClassOf :Sugarcane_Producer ;
                           rdfs:comment "Medium Producers (MP): Nations producing between 1 and 8 million tonnes (1–8 MT), indicating moderate production capacity." .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Principal_Producer
:Sugarcane_Principal_Producer rdf:type owl:Class ;
                              rdfs:subClassOf :Sugarcane_Producer ;
                              rdfs:comment "Principal Producers (PP): Nations with production volumes exceeding 100 MT (>100 MT), representing the highest tier of global production." .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Producer
:Sugarcane_Producer rdf:type owl:Class ;
                    rdfs:subClassOf :Global_Sugarcane_Feedstock_Supply_Chain ;
                    rdfs:comment "Sugarcane Producer class is made up of all cane producing nations. This class is subdvided into producers based on their tonnage levels." ;
                    rdfs:isDefinedBy "Previous work done on SCB Ontology for the valorisation of sugarcane bagasse residues is available on this link: https://doi.org/10.1016/B978-0-443-15274-0.50536-9" ;
                    rdfs:seeAlso "Survey of sugarcane producers was conducted using this link: https://uk.atlasbig.com/countries-by-sugarcane-production" .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Sugarcane_Top_Producer
:Sugarcane_Top_Producer rdf:type owl:Class ;
                        rdfs:subClassOf :Sugarcane_Producer ;
                        rdfs:comment "Top Producers (TP): Nations producing between 8 and 100 million tonnes (>8 MT ≤ 100 MT), denoting countries with substantial but sub-principal production levels." .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Technological_Factor_Indicator
:Technological_Factor_Indicator rdf:type owl:Class ;
                                rdfs:subClassOf :Pestle_Factor_Indicator .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Unavailable_Regional_Bioeconomy_Policy_Maturity_Score
:Unavailable_Regional_Bioeconomy_Policy_Maturity_Score rdf:type owl:Class ;
                                                       owl:equivalentClass [ owl:intersectionOf ( :Regional_Bioeconomy_Policy_Maturity_Score
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty :has_Regional_Bioeconomy_Policy_Maturity_Score ;
                                                                                                    owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                         owl:onDatatype xsd:decimal ;
                                                                                                                         owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                                                                                                                ]
                                                                                                                                                [ xsd:maxExclusive 1.0
                                                                                                                                                ]
                                                                                                                                              )
                                                                                                                       ]
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                       rdfs:subClassOf :Regional_Bioeconomy_Policy_Maturity_Score .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Very_High_Arable_Land_Mass
