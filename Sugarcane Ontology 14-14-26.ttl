###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Asia_Region
:Asia_Region rdf:type owl:Class ;
             rdfs:subClassOf :Sugarcane_Geo_Spatial_Region .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Developing_Innovation
:Developing_Innovation rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :Global_Innovation_Index_Score
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :has_Global_Innovation_Index ;
                                                                    owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                         owl:onDatatype xsd:decimal ;
                                                                                         owl:withRestrictions ( [ xsd:minExclusive 25.0
                                                                                                                ]
                                                                                                              )
                                                                                       ]
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :has_Global_Innovation_Index ;
                                                                    owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                         owl:onDatatype xsd:decimal ;
                                                                                         owl:withRestrictions ( [ xsd:maxInclusive 35.0
                                                                                                                ]
                                                                                                              )
                                                                                       ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf :Global_Innovation_Index_Score .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Developing_Regional_Bioeconomy_Policy_Maturity_Score
:Developing_Regional_Bioeconomy_Policy_Maturity_Score rdf:type owl:Class ;
                                                      owl:equivalentClass [ owl:intersectionOf ( :Regional_Bioeconomy_Policy_Maturity_Score
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty :has_Regional_Bioeconomy_Policy_Maturity_Score ;
                                                                                                   owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                        owl:onDatatype xsd:decimal ;
                                                                                                                        owl:withRestrictions ( [ xsd:minInclusive 3.0
                                                                                                                                               ]
                                                                                                                                               [ xsd:maxExclusive 4.0
                                                                                                                                               ]
                                                                                                                                             )
                                                                                                                      ]
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                      rdfs:subClassOf :Regional_Bioeconomy_Policy_Maturity_Score .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Economic_Factor_Indicator
:Economic_Factor_Indicator rdf:type owl:Class ;
