@prefix : <http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix fn: <http://www.w3.org/2005/xpath-functions#> .
@prefix kw: <http://franz.com/ns/keyword#> .
@prefix nd: <http://franz.com/ns/allegrograph/5.0/geo/nd#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .
@prefix err: <http://www.w3.org/2005/xqt-errors#> .
@prefix fti: <http://franz.com/ns/allegrograph/2.2/textindex/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ndfn: <http://franz.com/ns/allegrograph/5.0/geo/nd/fn#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix keyword: <http://franz.com/ns/keyword#> .
@base <http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#> .

<http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2> rdf:type owl:Ontology ;
                                                                                     rdfs:comment "Sugarcane Supply Chain supporting feedstock diversification within producing nations for  the advancement of global circular bioeconomies." .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#located_In_Geospatial_Region
:located_In_Geospatial_Region rdf:type owl:ObjectProperty ;
                              rdfs:domain :Sugarcane_Geo_Spatial_Region ,
                                          :Sugarcane_Producer .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Arable_Land_Acreage
:has_Arable_Land_Acreage rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Arable_Land_Acreage ,
                                     :Sugarcane_Bioeconomy ;
                         rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Arable_Land_Acreage_Per_Capita
:has_Arable_Land_Acreage_Per_Capita rdf:type owl:DatatypeProperty ;
                                    rdfs:domain :Arable_Land_Acreage_Per_Capita ,
                                                :Sugarcane_Bioeconomy ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:comment "All values are expressed in hectare per capita (ha/cap)." .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Emission_Per_Capita
:has_Emission_Per_Capita rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Emission_Per_Capita ,
                                     :Sugarcane_Bioeconomy ;
                         rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Global_Innovation_Index
:has_Global_Innovation_Index rdf:type owl:DatatypeProperty ;
                             rdfs:domain :Global_Innovation_Index_Score ,
                                         :Sugarcane_Bioeconomy ;
                             rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Gross_Domestic_Product_Per_Capita
:has_Gross_Domestic_Product_Per_Capita rdf:type owl:DatatypeProperty ;
                                       rdfs:domain :Gross_Domestic_Product_Per_Capita_Indicator ,
                                                   :Sugarcane_Bioeconomy ;
                                       rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Political_Risk_Index
:has_Political_Risk_Index rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Political_Risk_Index ,
                                      :Sugarcane_Bioeconomy ;
                          rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Regional_Bioeconomy_Policy_Maturity_Score
:has_Regional_Bioeconomy_Policy_Maturity_Score rdf:type owl:DatatypeProperty ;
                                               rdfs:domain :Regional_Bioeconomy_Policy_Maturity_Score ;
                                               rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Sugarcane_Acreage
:has_Sugarcane_Acreage rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Sugarcane_Acreage ,
                                   :Sugarcane_Bioeconomy ;
                       rdfs:range xsd:decimal .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#has_Sugarcane_Tonnage_Value
:has_Sugarcane_Tonnage_Value rdf:type owl:DatatypeProperty ;
                             rdfs:domain :Sugarcane_Bioeconomy ,
                                         :Sugarcane_Producer ;
                             rdfs:range xsd:decimal .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Advanced_Innovation
:Advanced_Innovation rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Global_Innovation_Index_Score
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :has_Global_Innovation_Index ;
                                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                       owl:onDatatype xsd:decimal ;
                                                                                       owl:withRestrictions ( [ xsd:minExclusive 45.0
                                                                                                              ]
                                                                                                            )
                                                                                     ]
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf :Global_Innovation_Index_Score .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Advanced_Regional_Bioeconomy_Policy_Maturity_Score
:Advanced_Regional_Bioeconomy_Policy_Maturity_Score rdf:type owl:Class ;
                                                    owl:equivalentClass [ owl:intersectionOf ( :Regional_Bioeconomy_Policy_Maturity_Score
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty :has_Regional_Bioeconomy_Policy_Maturity_Score ;
                                                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                      owl:onDatatype xsd:decimal ;
                                                                                                                      owl:withRestrictions ( [ xsd:minInclusive 4.0
                                                                                                                                             ]
                                                                                                                                           )
                                                                                                                    ]
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ] ;
                                                    rdfs:subClassOf :Regional_Bioeconomy_Policy_Maturity_Score .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Africa_Region
:Africa_Region rdf:type owl:Class ;
               rdfs:subClassOf :Sugarcane_Geo_Spatial_Region .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Americas_Region
:Americas_Region rdf:type owl:Class ;
                 rdfs:subClassOf :Sugarcane_Geo_Spatial_Region .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Arable_Land_Acreage
:Arable_Land_Acreage rdf:type owl:Class ;
                     rdfs:subClassOf :Sociological_Factor_Indicator .


###  http://www.semanticweb.org/maureenokibe/ontologies/2022/10/untitled-ontology-SCB2#Arable_Land_Acreage_Per_Capita
:Arable_Land_Acreage_Per_Capita rdf:type owl:Class ;
