@prefix : <https://w3id.org/owaimo/chapter4/pestle#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/owaimo/chapter4/pestle#> .

<https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential> rdf:type owl:Ontology ;
                                                                           rdfs:comment "Country-level ontology generated from the 'Producers and PESTLE Variables' worksheet. Spearman correlation results are intentionally excluded. Deployment classes are inferred from asserted country data."@en ;
                                                                           rdfs:label "Global Bagasse Electricity Deployment Potential Ontology"@en .

#################################################################
#    Data properties
#################################################################

###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasArableLandPerCapita
:hasArableLandPerCapita rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Sugarcane_Producer ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "Arable land per capita (Ha/cap)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasBagasseElectricityCapacity
:hasBagasseElectricityCapacity rdf:type owl:DatatypeProperty ;
                               rdfs:domain :Sugarcane_Producer ;
                               rdfs:range xsd:decimal ;
                               rdfs:label "Installed bagasse-based electricity generation capacity (MW)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasCO2EmissionPerCapita
:hasCO2EmissionPerCapita rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Sugarcane_Producer ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "CO2 emission per capita (tCO2/cap)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasDeploymentIntensity
:hasDeploymentIntensity rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Sugarcane_Producer ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "Deployment intensity (MW/Mt annual bagasse)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasEstimatedBagasse
:hasEstimatedBagasse rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Sugarcane_Producer ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "Estimated bagasse (Mt)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasGDPPerCapita
:hasGDPPerCapita rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Sugarcane_Producer ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "GDP per capita (USD)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasGII
:hasGII rdf:type owl:DatatypeProperty ;
        rdfs:domain :Sugarcane_Producer ;
        rdfs:range xsd:decimal ;
        rdfs:label "GII"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasPRI
:hasPRI rdf:type owl:DatatypeProperty ;
        rdfs:domain :Sugarcane_Producer ;
        rdfs:range xsd:decimal ;
        rdfs:label "PRI"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasSugarcaneHarvestedArea
:hasSugarcaneHarvestedArea rdf:type owl:DatatypeProperty ;
                           rdfs:domain :Sugarcane_Producer ;
                           rdfs:range xsd:decimal ;
                           rdfs:label "Sugarcane harvested area (Mha)"@en .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#hasSugarcaneProduction
:hasSugarcaneProduction rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Sugarcane_Producer ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "Sugarcane production (Mt)"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#High_Bagasse_Electricity_Deployment
:High_Bagasse_Electricity_Deployment rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( :Sugarcane_Producer
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :hasDeploymentIntensity ;
                                                                                  owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                       owl:onDatatype xsd:decimal ;
                                                                                                       owl:withRestrictions ( [ xsd:minInclusive 81.383333
                                                                                                                              ]
                                                                                                                            )
                                                                                                     ]
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:subClassOf :Sugarcane_Producer .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#High_Resource_Low_Deployment
:High_Resource_Low_Deployment rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( :Sugarcane_Producer
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :hasDeploymentIntensity ;
                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                owl:onDatatype xsd:decimal ;
                                                                                                owl:withRestrictions ( [ xsd:maxExclusive 44.416667
                                                                                                                       ]
                                                                                                                     )
                                                                                              ]
                                                                         ]
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :hasEstimatedBagasse ;
                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                owl:onDatatype xsd:decimal ;
                                                                                                owl:withRestrictions ( [ xsd:minInclusive 0.420000
                                                                                                                       ]
                                                                                                                     )
                                                                                              ]
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf :Sugarcane_Producer .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#Low_Bagasse_Electricity_Deployment
:Low_Bagasse_Electricity_Deployment rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( :Sugarcane_Producer
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasDeploymentIntensity ;
                                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                      owl:onDatatype xsd:decimal ;
                                                                                                      owl:withRestrictions ( [ xsd:maxExclusive 44.416667
                                                                                                                             ]
                                                                                                                           )
                                                                                                    ]
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:subClassOf :Sugarcane_Producer .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#Moderate_Bagasse_Electricity_Deployment
:Moderate_Bagasse_Electricity_Deployment rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( :Sugarcane_Producer
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasDeploymentIntensity ;
                                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                           owl:onDatatype xsd:decimal ;
                                                                                                           owl:withRestrictions ( [ xsd:minInclusive 44.416667
                                                                                                                                  ]
                                                                                                                                  [ xsd:maxExclusive 81.383333
                                                                                                                                  ]
                                                                                                                                )
                                                                                                         ]
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf :Sugarcane_Producer .


###  https://w3id.org/owaimo/global-bagasse-electricity-deployment-potential#Sugarcane_Producer
:Sugarcane_Producer rdf:type owl:Class .


